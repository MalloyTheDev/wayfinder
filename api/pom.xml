<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>dev.malloy</groupId>
  <artifactId>wayfinder-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Wayfinder API</name>
  <description>Destination catalog and ranking service</description>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <archunit.version>1.5.1</archunit.version>
  </properties>

  <dependencies>
    <!-- Not spring-boot-starter-web: that name is deprecated in Boot 4 in favour of this one. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      Schema is owned by migrations, never by Hibernate's ddl-auto.

      This is the starter rather than flyway-core directly. Spring Boot 4 moved Flyway's
      auto-configuration into its own module, so depending on flyway-core alone puts the
      library on the classpath with nothing wired to run it: migrations silently never
      execute and the application starts against an empty schema.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Spring Boot 4 split the test slices out of spring-boot-test-autoconfigure into one
      module per technology, so @DataJpaTest and @WebMvcTest are no longer pulled in by
      spring-boot-starter-test alone. Declaring only the two slices actually used keeps
      the test classpath to what the tests need.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      ADR-0001 rejected an embedded database for tests. Persistence tests run against the
      same Postgres engine as production, which is what makes constraint and ordering
      behaviour trustworthy.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Testcontainers 2.x coordinates. The 2.0 release prefixed every artifact with
      "testcontainers-", so the old org.testcontainers:postgresql name does not exist at
      this version. Versions come from Spring Boot's dependency management, which tracks
      the 2.x line; pinning them here is what previously held the build two majors back.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      ArchUnit enforces the layering ADR-0001 commits to. Without it, "the domain depends
      on no framework" is a sentence in a comment that nothing checks, which is precisely
      the kind of unverified claim this project exists to avoid.

      The plain artifact rather than archunit-junit5, so the rules run as ordinary JUnit
      tests and the build does not depend on ArchUnit's JUnit integration tracking the
      Jupiter 6 baseline Boot 4 sets.
    -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
